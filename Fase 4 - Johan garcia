        servicios["sala"] = sistema.registrar_servicio(ReservaSala("Sala de reuniones A", 50000, 12))
        servicios["equipo"] = sistema.registrar_servicio(AlquilerEquipo("Proyector HD", 80000, 4))
        servicios["asesoria"] = sistema.registrar_servicio(
            AsesoriaEspecializada("Asesoría de software", 90000, "Desarrollo Python"))
        return [s.describir() for s in sistema.servicios]
    ejecutar_operacion(4, "Registrar tres servicios especializados", registrar_servicios, estadisticas)
    ejecutar_operacion(5, "Crear servicio con tarifa negativa",
        lambda: ReservaSala("Sala inválida", -1000, 10), estadisticas)

    def reserva_exitosa():
        r = sistema.crear_reserva(clientes["johan"].id, servicios["sala"].id, 2,
                                  impuesto=0.19, descuento=0.10)
        reservas["r1"] = r
        r.confirmar()
        total = r.procesar()
        return f"{r.resumen()} | Total: ${total:.2f}"
    ejecutar_operacion(6, "Crear, confirmar y procesar reserva exitosa", reserva_exitosa, estadisticas)
    ejecutar_operacion(7, "Reserva para cliente inexistente",
        lambda: sistema.crear_reserva("NO_EXISTE", servicios["sala"].id, 1), estadisticas)

    def reservar_equipo_no_disponible():
        servicios["equipo"].cambiar_disponibilidad(False)
        return sistema.crear_reserva(clientes["johan"].id, servicios["equipo"].id, 1)
    ejecutar_operacion(8, "Reservar servicio no disponible",
        reservar_equipo_no_disponible, estadisticas)
    ejecutar_operacion(9, "Reserva con duración cero",
        lambda: sistema.crear_reserva(clientes["johan"].id, servicios["asesoria"].id, 0),
        estadisticas)

    def crear_y_cancelar():
        r = sistema.crear_reserva(clientes["johan"].id, servicios["asesoria"].id, 1)
        reservas["r2"] = r
        r.cancelar()
        return r.resumen()
    ejecutar_operacion(10, "Crear y cancelar una reserva", crear_y_cancelar, estadisticas)

    def procesar_sin_confirmar():
        r = sistema.crear_reserva(clientes["johan"].id, servicios["asesoria"].id, 1)
        reservas["r3"] = r
        return r.procesar()
    ejecutar_operacion(11, "Procesar reserva sin confirmarla", procesar_sin_confirmar, estadisticas)

    def probar_calculos():
        s = servicios["sala"]
        return (f"Normal: ${s.calcular_costo(2):.2f}; "
                f"con impuesto: ${s.calcular_costo(2, 0.19):.2f}; "
                f"con impuesto y descuento: ${s.calcular_costo(2, 0.19, 0.10):.2f}")
    ejecutar_operacion(12, "Probar variantes de calcular_costo", probar_calculos, estadisticas)

    pendientes = sum(r.estado == EstadoReserva.PENDIENTE for r in sistema.reservas)
    confirmadas = sum(r.estado == EstadoReserva.CONFIRMADA for r in sistema.reservas)
    procesadas = sum(r.estado == EstadoReserva.PROCESADA for r in sistema.reservas)
    canceladas = sum(r.estado == EstadoReserva.CANCELADA for r in sistema.reservas)
    disponibles = pendientes + confirmadas
    servicios_disponibles = sum(s.disponible for s in sistema.servicios)

    print("\n" + "=" * 60)
    print("INFORME ESTADÍSTICO FINAL - SOFTWARE FJ")
    print("=" * 60)
    print(f"Operaciones realizadas: {estadisticas['total']}")
    print(f"Operaciones exitosas: {estadisticas['exitosas']}")
    print(f"Operaciones fallidas controladas: {estadisticas['fallidas_controladas']}")
    print(f"Comprobación: {estadisticas['exitosas']} + "
          f"{estadisticas['fallidas_controladas']} = {estadisticas['total']}")
    print("\nESTADO DE LAS RESERVAS")
    print(f"Reservas creadas: {len(sistema.reservas)}")
    print(f"Pendientes: {pendientes}")
    print(f"Confirmadas: {confirmadas}")
    print(f"Disponibles (pendientes + confirmadas): {disponibles}")
    print(f"Procesadas: {procesadas}")
    print(f"Canceladas: {canceladas}")
    print("\nDISPONIBILIDAD DE SERVICIOS")
    print(f"Servicios registrados: {len(sistema.servicios)}")
    print(f"Servicios disponibles: {servicios_disponibles}")
    print(f"Servicios no disponibles: {len(sistema.servicios)-servicios_disponibles}")
    print("\nDETALLE DE RESERVAS")
    for linea in sistema.listar_reservas(): print("-", linea)
    print(f"\nAplicación finalizada. Logs: {RUTA_LOG}")

