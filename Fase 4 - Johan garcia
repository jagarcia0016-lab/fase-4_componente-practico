    estadisticas = {"total": 0, "exitosas": 0, "fallidas_controladas": 0}

    def registrar_johan():
        clientes["johan"] = sistema.registrar_cliente(
            Cliente("Johan", "johan@example.com", "3001234567"))
        return clientes["johan"].describir()

    ejecutar_operacion(1, "Registrar cliente válido: Johan", registrar_johan, estadisticas)
    ejecutar_operacion(2, "Cliente con correo inválido",
        lambda: Cliente("Luis", "correo-invalido", "3001234567"), estadisticas)
    ejecutar_operacion(3, "Cliente con teléfono inválido",
        lambda: Cliente("Marta", "marta@example.com", "12AB"), estadisticas)

